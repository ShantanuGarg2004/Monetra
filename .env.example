# Required
GROQ_API_KEY=your-groq-api-key
API_SECRET_KEY=your-chosen-api-secret
# Local Swagger password only (HTTP Basic on /apidocs/ and /apispec.json).
# It does not open profiles, reports, chat, or goals.
# Scoped keys are separate. From the repo root:
#   python scripts/issue_api_credential.py --email you@example.com --label local-load-test --scopes data,llm
# The script prints the raw key once. The database stores a hash.
# Rotate by revoking that row, then issuing another key:
#   python scripts/issue_api_credential.py --revoke 1
# SESSION_SECRET is not involved, so browsers stay signed in.
# Signs the browser session cookie. At least 32 characters, and not the same value as API_SECRET_KEY.
# Changing it signs every browser out.
SESSION_SECRET=replace-with-a-different-32-character-secret

# Transactional mail through Resend. Put the real key in .env only.
# EMAIL_FROM must be an address on the domain verified in Resend.
# APP_PUBLIC_URL is the frontend origin used in the mail links, with no path.
# On the laptop that is http://localhost:5173. On the API host it is the public site.
# EMAIL_API_KEY=re_your_resend_key
# EMAIL_FROM=FinPilot <noreply@monetra.site>
# APP_PUBLIC_URL=http://localhost:5173

# Optional model overrides
GROQ_REPORT_MODEL=openai/gpt-oss-120b
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Q6 load test only. true skips the Groq network call.
# GROQ_STUB=false
GROQ_REPORT_MAX_TOKENS=4096
GROQ_CHAT_MAX_TOKENS=1500

# Rate limiting — Wave 0 Flask-Limiter (fallback) + Wave 1 SQL store
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_STORAGE_BACKEND=sql
RATELIMIT_DATABASE_URL=postgresql+psycopg://finpilot:finpilot_dev_password@127.0.0.1:5432/finpilot_ratelimit
# Application data. A different database on the same PostgreSQL server as the limiter.
APP_DATABASE_URL=postgresql+psycopg://finpilot:finpilot_dev_password@127.0.0.1:5432/finpilot
# Optional quota overrides (parsed by the limits package). PDF rebuild is separate from GET /report.
# RATELIMIT_READ=120 per minute
# RATELIMIT_PDF_REBUILD=5 per minute

# development | production (affects default read rate ceilings and whether Swagger is on)
FLASK_ENV=development

# Q5 — required only when finance.db already has profiles with no account.
# The password is hashed on startup. It is the bootstrap person's login.
# BOOTSTRAP_ACCOUNT_EMAIL=you@example.com
# BOOTSTRAP_ACCOUNT_PASSWORD=choose-a-long-password

# Q4 — browser origins allowed to call /api. Comma-separated. Unset means local Vite only.
# An empty list is rejected when FLASK_ENV is not development/dev/local.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Wave 3 — worker sizing and timeouts (worker timeout must exceed Groq timeout)
GROQ_TIMEOUT_SECONDS=90
WORKER_TIMEOUT_SECONDS=120
# Claim threads inside the one worker process. Leave this at 1 unless a cost decision says otherwise.
WORKER_CLAIM_THREADS=1
PEAK_CONCURRENT_LLM=4
WORKER_HEADROOM=2
# SQLITE_IMPORT defaults off. A normal start does not open a SQLite file.
# Set SQLITE_IMPORT=true only to copy an old finance.db into an empty public schema.

# Q3 — local directory for advisory PDFs (not S3). Override if the process cwd differs.
# PDF_STORAGE_DIR=data/pdfs
